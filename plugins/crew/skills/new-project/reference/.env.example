# Copy to .env for local development. Never commit .env.
SECRET_KEY=
DEBUG=True

# The product's name and the client's, shown in the top bar.
# PRODUCT_NAME=
# CLIENT_NAME=

# Optional
# ALLOWED_HOSTS_EXTRA=
# DATA_DIR=
# Postgres instead of SQLite: set POSTGRES_HOST. The default sslmode is
# require; a local server needs disable.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=disable
