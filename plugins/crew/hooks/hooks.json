{
  "description": "The crew's guards and checks. guard_db: no agent writes to the database. guard_edit: no agent edits a file outside its memory directory. guard_tree: the Lookout leaves the tree as it found it. template_leaks: a template construct split across lines is reported the moment it is written. before_stop: a model change has its migration and no changed template leaks, before the main session calls the turn done.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" guard_db",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" guard_edit",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(crew:)?lookout$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" guard_tree snapshot",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(crew:)?lookout$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" guard_tree check",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" template_leaks",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/crew-hook.sh\" before_stop",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
